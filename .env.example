# AlphaForge — environment configuration
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# The `.env` file is git-ignored. NEVER commit real API keys or secrets to the
# repository. These credentials are only needed for the Alpaca paper-order
# integration (`pip install -e ".[live]"`); core backtesting works without them.
# PaperTrader reads the ALPACA_* values below from `.env` in the current directory
# or its nearest parent that has one; a real environment variable or a constructor
# argument wins. Nothing else in the Python package reads this file.

# --- Alpaca Markets (paper trading) -----------------------------------------
# Create free paper-trading keys at https://alpaca.markets (Paper Trading tab).

# Your Alpaca API key ID.
ALPACA_API_KEY=your_alpaca_api_key_here

# Your Alpaca API secret key.
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Alpaca API base URL. Defaults to the paper-trading endpoint below.
# Use the live endpoint only if you know what you are doing — AlphaForge is
# intended for research and paper trading, not live capital. PaperTrader
# refuses any non-paper URL here unless constructed with allow_live=True, and
# an explicit PaperTrader(base_url=...) argument always wins over this value.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Web dashboard ----------------------------------------------------------
# URL of the AlphaForge FastAPI engine the Next.js frontend calls. Inlined
# into the browser bundle at BUILD time (NEXT_PUBLIC_*). Next reads it from the
# environment or from frontend/.env.local, NOT from this repo-root file. `npm run
# dev` falls back to this localhost value when unset; a production build does not
# (it then calls no API and shows the recorded snapshot).
# If the API is unreachable, the frontend shows only the recorded engine
# snapshot of its default configuration (frontend/public/engine-snapshot/);
# every other configuration shows no results. Nothing is simulated in-browser.
NEXT_PUBLIC_API_URL=http://localhost:8003
