# AlphaForge frontend environment.
#
# Copy to `.env.local` for local dev (git-ignored by Next.js):
#     cp .env.example .env.local
#
# URL of the FastAPI engine API. Read at BUILD time and inlined into the
# browser bundle (NEXT_PUBLIC_* convention); only `npm run dev` falls back to
# http://localhost:8003 when it is unset. Set NEXT_PUBLIC_SITE_URL too for
# absolute share-image links (none are emitted without it). If unreachable, the dashboard
# shows only the recorded engine snapshot of its default configuration
# (public/engine-snapshot/) and no results for anything else.
NEXT_PUBLIC_API_URL=http://localhost:8003
